# Docker Compose 启动 stock-web 时使用的镜像名。
TDX_STOCK_WEB_IMAGE=tdx-api-stock-web:invest-grade-fixed

# 数据根目录；生产或本机长期运行建议指向仓库外的 state 数据资产目录。
TDX_DATA_DIR=./data/database

# 行业名称补全使用的 incon.dat 显式路径；为空时按默认搜索路径查找。
TDX_INCON_PATH=

# 指数代码覆盖列表，逗号分隔 full code，例如 sh000001,sz399001；为空时读取 index_codes.json 或内置默认值。
TDX_INDEX_CODES=

# Web 服务测试开关；正常运行必须保持 0 或留空，设为 1 会跳过 init。
TDX_WEB_SKIP_INIT=0

# 启动时是否暂停 collector 自动执行；1/true 表示只启动服务但不自动采集。
COLLECTOR_START_PAUSED=0

# collector 全域补采起始日，格式 YYYYMMDD；为空时按 provider-earliest 逻辑决定。
COLLECTOR_BOOTSTRAP_START=

# 逐笔成交历史补采起始日，格式 YYYYMMDD；用于限制 trade 域历史回补跨度。
COLLECTOR_TRADE_BOOTSTRAP_START=20190101

# live 相关数据补采起始日，格式 YYYYMMDD；用于限制 live 域历史回补跨度。
COLLECTOR_LIVE_BOOTSTRAP_START=20190101

# 非启动补采任务的整体超时时间；Go duration 格式，例如 6h、90m。
COLLECTOR_RUN_TIMEOUT=6h

# 启动补采任务的整体超时时间；0 或留空表示不设置整体 deadline。
COLLECTOR_STARTUP_CATCHUP_TIMEOUT=0

# collector 请求 TDX provider 的最小间隔；Go duration 格式，降低可提速但更容易触发限流。
COLLECTOR_REQUEST_MIN_INTERVAL=150ms

# collector 补采并发 worker 数；默认 4，代码上限 32。
COLLECTOR_CATCHUP_WORKERS=4

# deep audit backfill 的 cron 表达式；为空表示不注册定时任务，只保留手动触发。
COLLECTOR_DEEP_AUDIT_SCHEDULE=

# professional finance 后台刷新硬停开关；1/true 表示禁用自动预取，只保留查询服务。
PROFINANCE_DISABLE_BACKGROUND_REFRESH=0

# professional finance 自动刷新前要求的最小可用磁盘字节数；低于该值会跳过后台刷新。
PROFINANCE_MIN_FREE_BYTES=10737418240

# hot/cold 生命周期数据集逻辑名；会写入 cold URI，未来对象存储迁移也依赖该命名。
TDX_LIFECYCLE_DATASET=a-stock-market-tdx

# hot/cold 生命周期总开关；默认启用，用于持续保持热库 180 个交易日。
TDX_LIFECYCLE_ENABLE=1

# hot/cold 生命周期维护 cron 表达式；仅在 TDX_LIFECYCLE_ENABLE=1 时生效。
TDX_LIFECYCLE_SCHEDULE="0 0 21 * * *"

# 是否允许生命周期任务在归档校验后裁剪热库；默认启用，冷归档验证通过后释放热库旧数据。
TDX_LIFECYCLE_ALLOW_PRUNE=1

# 裁剪热库后是否保留替换前的热库备份文件；1 会降低误删风险但不释放磁盘。
TDX_LIFECYCLE_KEEP_BACKUP=0

# restore-test 生成的临时恢复库是否保留；1 便于人工排查但会占用更多磁盘。
TDX_LIFECYCLE_KEEP_RESTORE_TEST_DB=0

# 允许裁剪前要求已通过验证的最小 segment 数；用于避免恢复链路尚未充分验证时删除热数据。
TDX_LIFECYCLE_ALLOW_PRUNE_MIN_VERIFIED_SEGMENTS=100

# 单次生命周期维护最多处理的候选 segment 数；稳态需要足够预算消化每日滑出 180 日窗口的数据。
TDX_LIFECYCLE_MAX_CANDIDATES=400

# 单个候选最多归档的历史天数；用于把大跨度冷迁移拆成可恢复的小批次。
TDX_LIFECYCLE_MAX_ARCHIVE_DAYS=366

# 单轮 inventory 最多扫描的 SQLite 文件数；0 表示不限制。
TDX_LIFECYCLE_MAX_INVENTORY_FILES=0

# 候选排序策略；size_asc 优先处理小文件，size_desc 优先处理大文件。
TDX_LIFECYCLE_CANDIDATE_SORT=size_asc

# 测试或应急时覆盖检测到的可用磁盘字节数；0 表示使用真实磁盘水位。
TDX_LIFECYCLE_FREE_BYTES_OVERRIDE=0

# 生命周期维护启动前要求的最小可用磁盘字节数；低于该值会跳过写入型维护。
TDX_LIFECYCLE_MIN_FREE_BYTES=10737418240

# 生命周期空间模型额外安全余量字节数；用于避免导出/替换期间打满磁盘。
TDX_LIFECYCLE_SAFETY_MARGIN_BYTES=536870912

# 单轮生命周期维护运行预算；Go duration 格式，例如 30m、2h。
TDX_LIFECYCLE_RUNTIME_BUDGET=30m

# lifecycle-maintenance CLI 是否写 governance 记录；Web 内置调度不依赖该开关。
TDX_LIFECYCLE_GOVERNANCE_RECORD=1
